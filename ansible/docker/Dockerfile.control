# Ansible CONTROL node: the machine that runs the playbooks
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client curl \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir "ansible-core>=2.17,<2.19"

COPY docker/control-entrypoint.sh /usr/local/bin/control-entrypoint.sh
RUN chmod +x /usr/local/bin/control-entrypoint.sh

WORKDIR /ansible
ENTRYPOINT ["/usr/local/bin/control-entrypoint.sh"]
