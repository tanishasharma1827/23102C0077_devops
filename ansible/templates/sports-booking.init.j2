#!/bin/sh
# {{ ansible_managed }}
### BEGIN INIT INFO
# Provides:          {{ app_name }}
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Sports Facility Booking System
### END INIT INFO

NAME={{ app_name }}
APP_USER={{ app_user }}
APP={{ app_home }}/current.war
PIDFILE={{ app_home }}/run/$NAME.pid
LOG={{ app_home }}/logs/app.log
JAVA_OPTS="{{ java_opts }}"

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if is_running; then
    echo "$NAME already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$APP_USER" --chdir {{ app_home }} \
    --startas /bin/sh -- -c "exec java $JAVA_OPTS -jar $APP --spring.config.additional-location=file:{{ app_config_dir }}/ >> $LOG 2>&1"
  echo "$NAME started"
}

stop() {
  if is_running; then
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry TERM/30/KILL/5 >/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    rm -f "$PIDFILE"
    echo "$NAME not running"
  fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)
    if is_running; then echo "$NAME is running (pid $(cat "$PIDFILE"))"; else echo "$NAME is stopped"; exit 3; fi ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
